@implements IDisposable

@* Place inside an EditForm. Shows server-side field errors inline (via ValidationMessageStore) and a
   focusable error summary after a failed submit, so keyboard and screen-reader users land on the problem. *@
@if (_visible && (_general is not null || Messages.Any()))
{
    <div class="error-summary" role="alert" tabindex="-1" @ref="_element">
        <p class="error-summary__title">
            <Icon Name="alert" Size="18" /> @(Messages.Any() ? "Please fix the following:" : _general)
        </p>
        @if (Messages.Any())
        {
            <ul>
                @if (_general is not null)
                {
                    <li>@_general</li>
                }
                @foreach (var message in Messages)
                {
                    <li>@message</li>
                }
            </ul>
        }
    </div>
}

@code {
    private ValidationMessageStore _store = default!;
    private ElementReference _element;
    private string? _general;
    private bool _visible;
    private bool _focusPending;

    [CascadingParameter] private EditContext EditContext { get; set; } = default!;

    private IEnumerable<string> Messages => EditContext.GetValidationMessages().Distinct();

    protected override void OnInitialized()
    {
        _store = new ValidationMessageStore(EditContext);
        EditContext.OnValidationRequested += OnValidationRequested;
        EditContext.OnFieldChanged += OnFieldChanged;
        EditContext.OnValidationStateChanged += OnValidationStateChanged;
    }

    /// <summary>Call from OnInvalidSubmit: reveals the summary and moves focus to it.</summary>
    public void Focus()
    {
        _visible = true;
        _focusPending = true;
        StateHasChanged();
    }

    /// <summary>Maps an API error onto the form's fields; anything unmatched goes to the summary.</summary>
    public void Show(ApiException error)
    {
        _store.Clear();
        _general = null;
        var modelType = EditContext.Model.GetType();

        foreach (var (key, messages) in error.Errors)
        {
            var property = modelType.GetProperties()
                .FirstOrDefault(p => string.Equals(p.Name, key, StringComparison.OrdinalIgnoreCase));
            if (property is null)
                _general = string.Join(" ", messages);
            else
                _store.Add(EditContext.Field(property.Name), messages);
        }

        if (error.Errors.Count == 0)
            _general = error.Message;

        EditContext.NotifyValidationStateChanged();
        Focus();
    }

    public void Clear()
    {
        _store.Clear();
        _general = null;
        _visible = false;
        EditContext.NotifyValidationStateChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            try { await _element.FocusAsync(); } catch (InvalidOperationException) { /* nothing rendered */ }
        }
    }

    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _store.Clear();
        _general = null;
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _store.Clear(e.FieldIdentifier);
        EditContext.NotifyValidationStateChanged();
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        EditContext.OnValidationRequested -= OnValidationRequested;
        EditContext.OnFieldChanged -= OnFieldChanged;
        EditContext.OnValidationStateChanged -= OnValidationStateChanged;
    }
}
