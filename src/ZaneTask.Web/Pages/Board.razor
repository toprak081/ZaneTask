@page "/projects/{ProjectId:guid}"
@using ZaneTask.Web.Components.Board
@inject ApiClient Api
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>@(_project?.Name ?? "Board") · ZaneTask</PageTitle>

<div class="board-page">
    @if (_loadError is not null)
    {
        <div class="container">
            <div class="notice notice--error" role="alert">
                <Icon Name="alert" Size="18" />
                <span>@_loadError</span>
                <button type="button" class="btn btn--secondary btn--sm" @onclick="LoadAsync">Try again</button>
            </div>
            <a href="" class="back-link"><Icon Name="arrow-left" /> All projects</a>
        </div>
    }
    else if (_project is null || _tasks is null)
    {
        <div class="page-loading" role="status"><span class="spinner" aria-hidden="true"></span> Loading board…</div>
    }
    else
    {
        <div class="board-header">
            <a href="" class="back-link"><Icon Name="arrow-left" /> All projects</a>
            <div class="page-header">
                <div class="page-header__text">
                    <h1 class="page-title">@_project.Name</h1>
                    @if (_project.Description is not null)
                    {
                        <p class="text-muted">@_project.Description</p>
                    }
                </div>
                <div class="page-header__actions">
                    <div class="segmented" role="group" aria-label="View">
                        <button type="button" class="segmented__btn" aria-pressed="@(_view == BoardView)" @onclick="() => SetViewAsync(BoardView)">
                            <Icon Name="kanban" /> Board
                        </button>
                        <button type="button" class="segmented__btn" aria-pressed="@(_view == ListView)" @onclick="() => SetViewAsync(ListView)">
                            <Icon Name="list" /> List
                        </button>
                    </div>
                    <div class="avatar-stack" aria-label="@_project.Members.Count members">
                        @foreach (var member in _project.Members.Take(5))
                        {
                            <Avatar User="member.User" Small="true" @key="member.User.Id" />
                        }
                        @if (_project.Members.Count > 5)
                        {
                            <span class="avatar avatar--sm avatar--more">+@(_project.Members.Count - 5)</span>
                        }
                    </div>
                    <a class="btn btn--secondary" href="projects/@ProjectId/settings">
                        <Icon Name="settings" /> Settings
                    </a>
                    <button type="button" class="btn btn--primary" @onclick="() => _taskDialog.OpenNew(FirstColumn(TaskItemStatus.Todo))">
                        <Icon Name="plus" /> New task
                    </button>
                </div>
            </div>

            <div class="filters" role="search" aria-label="Filter tasks">
                <div class="field field--inline filters__search">
                    <label for="filter-search" class="sr-only">Search tasks</label>
                    <Icon Name="search" Class="filters__search-icon" />
                    <input id="filter-search" type="search" class="input" placeholder="Search or type a key, e.g. WEB-12"
                           @bind="_search" @bind:event="oninput" />
                </div>
                <div class="field field--inline">
                    <label for="filter-assignee">Assignee</label>
                    <select id="filter-assignee" class="input" @bind="_assigneeFilter">
                        <option value="">Anyone</option>
                        <option value="none">Unassigned</option>
                        <option value="@_currentUserId">Me</option>
                        @foreach (var member in _project.Members.Where(m => m.User.Id != _currentUserId))
                        {
                            <option value="@member.User.Id">@member.User.DisplayName</option>
                        }
                    </select>
                </div>
                @if (_project.Labels.Count > 0)
                {
                    <div class="field field--inline">
                        <label for="filter-label">Label</label>
                        <select id="filter-label" class="input" @bind="_labelFilter">
                            <option value="">Any</option>
                            @foreach (var label in _project.Labels)
                            {
                                <option value="@label.Id">@label.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="field field--inline">
                    <label for="filter-type">Type</label>
                    <select id="filter-type" class="input" @bind="_typeFilter">
                        <option value="">Any</option>
                        @foreach (var type in Display.Types)
                        {
                            <option value="@type">@type.Name()</option>
                        }
                    </select>
                </div>
                @if (HasFilters)
                {
                    <button type="button" class="btn btn--ghost btn--sm" @onclick="ClearFilters">
                        <Icon Name="x" /> Clear filters
                    </button>
                }
            </div>
        </div>

        @if (_view == ListView)
        {
            <TaskTable Tasks="_tasks.Where(Matches)" Columns="_project.Columns" Today="_today"
                       EmptyText="@(HasFilters && _tasks.Count > 0 ? "No matching tasks." : "No tasks yet.")"
                       OnOpen="t => _taskDialog.OpenAsync(t)" />
        }
        else
        {
            <div class="board" style="--columns: @_project.Columns.Count">
                @foreach (var col in _project.Columns)
                {
                    var tasks = TasksIn(col.Id).ToList();
                    var visible = tasks.Where(Matches).ToList();
                    <section class="column @(_dropColumnId == col.Id && _dragging is not null ? "is-drop-target" : null)"
                             aria-labelledby="col-@col.Id" @key="col.Id"
                             @ondragover:preventDefault="true"
                             @ondragenter="() => OnDragOverColumn(col.Id)"
                             @ondrop="() => DropAsync(col)">
                        <header class="column__header">
                            <h2 id="col-@col.Id" class="column__title">
                                <span class="status status--@col.Category.ToString().ToLowerInvariant()" title="@col.Category.Name()">
                                    <Icon Name="@col.Category.Icon()" />
                                </span>
                                @col.Name
                            </h2>
                            <span class="column__count" aria-label="@visible.Count tasks">@visible.Count</span>
                        </header>

                        @if (visible.Count == 0)
                        {
                            <p class="column__empty">@(HasFilters && tasks.Count > 0 ? "No matching tasks." : "Nothing here yet.")</p>
                        }
                        <ul class="column__list">
                            @foreach (var task in visible)
                            {
                                <TaskCard @key="task.Id"
                                          Item="task"
                                          Columns="_project.Columns"
                                          ColumnCount="tasks.Count"
                                          Today="_today"
                                          IsDragging="_dragging?.Id == task.Id"
                                          IsDropTarget="_dropBefore?.Id == task.Id && _dragging?.Id != task.Id"
                                          OnOpen="t => _taskDialog.OpenAsync(t)"
                                          OnDragStart="t => _dragging = t"
                                          OnDragEnd="ClearDrag"
                                          OnDragOverCard="OnDragOverCard"
                                          OnMove="m => MoveAsync(m.Task, m.ColumnId, m.Position)" />
                            }
                        </ul>

                        <button type="button" class="btn btn--ghost btn--block column__add" @onclick="() => _taskDialog.OpenNew(col.Id)">
                            <Icon Name="plus" /> Add task
                        </button>
                    </section>
                }
            </div>
        }

        <p class="sr-only" aria-live="polite">@_announcement</p>

        <TaskDialog @ref="_taskDialog" Project="_project" CurrentUserId="_currentUserId" OnChanged="ReloadTasksAsync" />
    }
</div>

@code {
    private ProjectDto? _project;
    private List<TaskDto>? _tasks;
    private string? _loadError;
    private Guid _currentUserId;
    private TaskDialog _taskDialog = default!;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private string _search = "";
    private string _assigneeFilter = "";
    private string _labelFilter = "";
    private string _typeFilter = "";

    private TaskDto? _dragging;
    private TaskDto? _dropBefore;
    private Guid? _dropColumnId;
    private string _announcement = "";

    [Parameter] public Guid ProjectId { get; set; }

    /// <summary>Deep link (e.g. from My tasks): opens this task's details once the board has loaded.</summary>
    [SupplyParameterFromQuery(Name = "task")] public Guid? OpenTaskId { get; set; }

    private Guid? _pendingOpen;

    private const string BoardView = "board";
    private const string ListView = "list";
    private string _view = BoardView;

    private string ViewStorageKey => $"zanetask.view.{ProjectId}";

    /// <summary>The chosen view is remembered per project in this browser (a convenience only).</summary>
    private async Task<string> LoadViewAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey) == ListView ? ListView : BoardView;
        }
        catch (JSException)
        {
            return BoardView;
        }
    }

    private async Task SetViewAsync(string view)
    {
        _view = view;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, view);
        }
        catch (JSException)
        {
            // Storage unavailable (e.g. private mode): the view just isn't remembered.
        }
    }

    private bool HasFilters =>
        _search.Length > 0 || _assigneeFilter.Length > 0 || _labelFilter.Length > 0 || _typeFilter.Length > 0;

    protected override async Task OnParametersSetAsync()
    {
        _currentUserId = (await AuthState.GetAuthenticationStateAsync()).User.UserId();
        _pendingOpen = OpenTaskId;
        _view = await LoadViewAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The dialog only exists once the board has rendered with data.
        if (_pendingOpen is { } id && _tasks is not null && _taskDialog is not null)
        {
            _pendingOpen = null;
            if (_tasks.FirstOrDefault(t => t.Id == id) is { } task)
                await _taskDialog.OpenAsync(task);
            else
                Toasts.Error("That task no longer exists.");
        }
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var project = Api.GetProjectAsync(ProjectId);
            var tasks = Api.GetTasksAsync(ProjectId);
            _project = await project;
            _tasks = await tasks;
        }
        catch (ApiException e)
        {
            _loadError = e.Message;
        }
    }

    private async Task ReloadTasksAsync()
    {
        try
        {
            _tasks = await Api.GetTasksAsync(ProjectId);
        }
        catch (ApiException e)
        {
            Toasts.Error(e.Message);
        }
    }

    private IEnumerable<TaskDto> TasksIn(Guid columnId) =>
        _tasks!.Where(t => t.ColumnId == columnId).OrderBy(t => t.Position);

    /// <summary>Leftmost column of a category, or the leftmost column.</summary>
    private Guid FirstColumn(TaskItemStatus category) =>
        (_project!.Columns.FirstOrDefault(c => c.Category == category) ?? _project.Columns[0]).Id;

    private string ColumnName(Guid columnId) => _project!.Columns.FirstOrDefault(c => c.Id == columnId)?.Name ?? "another column";

    private bool Matches(TaskDto task)
    {
        var search = _search.Trim();
        if (search.Length > 0 &&
            !task.Key.Equals(search, StringComparison.OrdinalIgnoreCase) &&
            !task.Title.Contains(search, StringComparison.OrdinalIgnoreCase) &&
            !(task.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
            return false;

        if (_assigneeFilter == "none" && task.Assignee is not null)
            return false;
        if (Guid.TryParse(_assigneeFilter, out var assignee) && task.Assignee?.Id != assignee)
            return false;

        if (Guid.TryParse(_labelFilter, out var label) && task.Labels.All(l => l.Id != label))
            return false;

        if (Enum.TryParse<TaskType>(_typeFilter, out var type) && task.Type != type)
            return false;

        return true;
    }

    private void ClearFilters() => (_search, _assigneeFilter, _labelFilter, _typeFilter) = ("", "", "", "");

    // Drag and drop -------------------------------------------------------

    private void OnDragOverCard(TaskDto target)
    {
        if (_dragging is null)
            return;
        _dropBefore = target;
        _dropColumnId = target.ColumnId;
    }

    private void OnDragOverColumn(Guid columnId)
    {
        if (_dragging is null || _dropColumnId == columnId)
            return;
        _dropColumnId = columnId;
        _dropBefore = null;
    }

    private async Task DropAsync(BoardColumnDto column)
    {
        if (_dragging is not { } task)
            return;

        int position;
        if (_dropBefore is { } before && before.ColumnId == column.Id && before.Id != task.Id)
        {
            // The server removes the task before inserting, so moving down within a column shifts by one.
            position = before.Position - (task.ColumnId == column.Id && task.Position < before.Position ? 1 : 0);
        }
        else
        {
            position = int.MaxValue / 2; // end of the column; the server clamps it
        }

        ClearDrag();
        await MoveAsync(task, column.Id, position);
    }

    private void ClearDrag()
    {
        _dragging = null;
        _dropBefore = null;
        _dropColumnId = null;
    }

    // Moving (shared by drag and drop and the Move menu) --------------------

    private async Task MoveAsync(TaskDto task, Guid columnId, int position)
    {
        if (task.ColumnId == columnId && task.Position == position)
            return;

        var category = _project!.Columns.First(c => c.Id == columnId).Category;
        var snapshot = _tasks!;
        _tasks = ApplyMove(snapshot, task, columnId, category, position);
        var moved = _tasks.First(t => t.Id == task.Id);
        _announcement = $"Moved “{task.Title}” to {ColumnName(columnId)}, position {moved.Position + 1}.";
        StateHasChanged();

        try
        {
            await Api.MoveTaskAsync(task.Id, columnId, moved.Position);
        }
        catch (ApiException e)
        {
            _tasks = snapshot;
            Toasts.Error($"Couldn't move the task. {e.Message}");
        }
    }

    /// <summary>Client-side mirror of the server's KanbanBoard.Move, for instant feedback.</summary>
    private static List<TaskDto> ApplyMove(List<TaskDto> tasks, TaskDto task, Guid columnId, TaskItemStatus category, int position)
    {
        var result = tasks.Where(t => t.ColumnId != columnId && t.ColumnId != task.ColumnId).ToList();

        var target = tasks.Where(t => t.ColumnId == columnId && t.Id != task.Id).OrderBy(t => t.Position).ToList();
        target.Insert(Math.Clamp(position, 0, target.Count), task with { ColumnId = columnId, Status = category });
        result.AddRange(target.Select((t, i) => t with { Position = i }));

        if (task.ColumnId != columnId)
        {
            var source = tasks.Where(t => t.ColumnId == task.ColumnId && t.Id != task.Id).OrderBy(t => t.Position);
            result.AddRange(source.Select((t, i) => t with { Position = i }));
        }

        return result;
    }
}
